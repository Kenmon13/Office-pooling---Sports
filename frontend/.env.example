# Copy to .env before building the iOS/Android apps. See MOBILE.md.
# Both are baked into the bundle at build time and only affect native builds.

# Where the packaged app sends its API calls.
VITE_API_BASE=https://sportspooling.com

# iOS OAuth client ID from the Google Cloud Console. The reversed form of this
# value also has to go into frontend/ios/App/App/Info.plist.
VITE_GOOGLE_IOS_CLIENT_ID=

# Turn on ONLY once the Firebase config files are in place:
#   Android  frontend/android/app/google-services.json
#   iOS      frontend/ios/App/App/GoogleService-Info.plist
# Enabling this without them makes the app crash the moment a user grants
# notification permission — the native Firebase call throws and cannot be caught.
VITE_PUSH_ENABLED=false
