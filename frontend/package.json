    "cap:assets": "npx --yes @capacitor/assets@3 generate --ios --android --iconBackgroundColor '#0b1a0b' --iconBackgroundColorDark '#0b1a0b' --splashBackgroundColor '#0b1a0b' --splashBackgroundColorDark '#0b1a0b'"
  },
  "dependencies": {
