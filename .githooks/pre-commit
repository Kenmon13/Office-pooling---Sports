#!/bin/sh
# Auto-generates patch notes from staged changes before each commit.
# Requires ANTHROPIC_API_KEY to be set in your environment.
# Skip for a single commit with: SKIP_PATCHNOTES=1 git commit ...

if [ "$SKIP_PATCHNOTES" = "1" ]; then
  exit 0
fi

if [ -z "$ANTHROPIC_API_KEY" ]; then
  echo "[patchnotes] ANTHROPIC_API_KEY not set — skipping."
  exit 0
fi

node scripts/generate-patchnotes.js --staged
